rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && me().role == 'admin'; }
    function isFarmer() { return signedIn() && me().role == 'farmer'; }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function reviewPath(orderId) {
      return /databases/$(db)/documents/reviews/$(orderId);
    }
    function ownsDeliveredUnreviewedOrder(orderId) {
      let order = get(/databases/$(db)/documents/orders/$(orderId));
      return signedIn()
        && order.data.customerUid == request.auth.uid
        && order.data.status == 'delivered'
        && order.data.reviewed != true
        && request.resource.data.farmerUid == order.data.farmerUid;
    }
    function matchingReviewExistsAfter(orderId) {
      return existsAfter(reviewPath(orderId))
        && getAfter(reviewPath(orderId)).data.orderId == orderId
        && getAfter(reviewPath(orderId)).data.customerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role in ['customer', 'farmer']
                    && request.resource.data.isBlocked == false;
      allow update: if signedIn() && (
        (request.auth.uid == uid && onlyChanges(['name','phone','photoUrl','fcmToken',
           'addresses','favoriteProductIds','followedFarmIds'])) || isAdmin());
    }

    match /farms/{farmId} {
      allow read: if signedIn();
      allow create: if isFarmer() && request.auth.uid == farmId;
      allow update: if (isFarmer() && request.auth.uid == farmId)
                    || isAdmin()
                    || (signedIn()
                        && onlyChanges(['ratingAvg','ratingCount','lastReviewOrderId'])
                        && request.resource.data.ratingAvg is number
                        && request.resource.data.ratingAvg >= 0
                        && request.resource.data.ratingAvg <= 5
                        && request.resource.data.ratingCount == resource.data.ratingCount + 1
                        && matchingReviewExistsAfter(request.resource.data.lastReviewOrderId)
                        && getAfter(reviewPath(request.resource.data.lastReviewOrderId)).data.farmerUid == farmId);
    }

    match /products/{id} {
      allow read: if signedIn();
      allow create: if isFarmer() && request.resource.data.farmerUid == request.auth.uid
                    && request.resource.data.price > 0
                    && request.resource.data.quantityAvailable is number
                    && request.resource.data.quantityAvailable > 0;
      allow update: if signedIn() && (
        resource.data.farmerUid == request.auth.uid || isAdmin() ||
        onlyChanges(['quantityAvailable','totalSold','ratingAvg','ratingCount','updatedAt']) ||
        (onlyChanges(['ratingAvg','ratingCount','lastReviewOrderId'])
         && request.resource.data.ratingAvg is number
         && request.resource.data.ratingAvg >= 0
         && request.resource.data.ratingAvg <= 5
         && request.resource.data.ratingCount == resource.data.ratingCount + 1
         && matchingReviewExistsAfter(request.resource.data.lastReviewOrderId)
         && getAfter(reviewPath(request.resource.data.lastReviewOrderId)).data.productIds.hasAny([id])
         && getAfter(reviewPath(request.resource.data.lastReviewOrderId)).data.farmerUid == resource.data.farmerUid));
      allow delete: if signedIn() && (resource.data.farmerUid == request.auth.uid || isAdmin());
    }

    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid
                                 || resource.data.farmerUid == request.auth.uid || isAdmin());
      allow update: if isAdmin()
                    || (signedIn()
                        && resource.data.customerUid == request.auth.uid
                        && resource.data.status == 'delivered'
                        && resource.data.reviewed != true
                        && request.resource.data.reviewed == true
                        && onlyChanges(['reviewed'])
                        && matchingReviewExistsAfter(id))
                    || (signedIn()
                        && resource.data.customerUid == request.auth.uid
                        && resource.data.status == 'placed'
                        && request.resource.data.status == 'cancelled'
                        && onlyChanges(['status','statusHistory','updatedAt']))
                    || (signedIn()
                        && resource.data.farmerUid == request.auth.uid
                        && onlyChanges(['status','statusHistory','updatedAt','paymentStatus'])
                        && request.resource.data.status in ['placed','accepted','rejected','packed','out_for_delivery','delivered','cancelled']
                        && (request.resource.data.paymentStatus == resource.data.paymentStatus
                            || (resource.data.paymentMethod == 'upi'
                                && request.resource.data.paymentStatus == 'paid')
                            || (resource.data.paymentMethod == 'cod'
                                && request.resource.data.status == 'delivered'
                                && request.resource.data.paymentStatus == 'paid')));
    }

    match /reviews/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && id == request.resource.data.orderId
        && request.resource.data.keys().hasOnly(['orderId','farmerUid','customerUid','customerName','productIds','rating','comment','createdAt'])
        && request.resource.data.keys().hasAll(['orderId','farmerUid','customerUid','customerName','productIds','rating','comment','createdAt'])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.customerName is string
        && request.resource.data.productIds is list
        && request.resource.data.comment is string
        && request.resource.data.createdAt is timestamp
        && ownsDeliveredUnreviewedOrder(request.resource.data.orderId);
    }

    match /harvestAlerts/{id} {
      allow read: if signedIn();
      allow create: if isFarmer() && request.resource.data.farmerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.farmerUid == request.auth.uid;
    }

    match /searchLogs/{id} {
      allow create: if signedIn();
      allow read: if isAdmin();
    }
  }
}
